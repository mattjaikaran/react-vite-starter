{
  "name": "react-vite-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:strict": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "doctor": "react-doctor . --yes --no-telemetry --no-supply-chain --blocking error",
    "check-conventions": "bun run scripts/check_conventions.ts",
    "check-dependencies": "bun run scripts/check_dependencies.ts",
    "gauntlet": "bun run lint && bun run typecheck && bun run test && bun run check-conventions && bun run check-dependencies"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-query-devtools": "5.100.14",
    "axios": "1.7.0",
    "clsx": "2.1.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-hook-form": "7.53.0",
    "react-router-dom": "7.1.0",
    "tailwind-merge": "2.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.50.0",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "jsdom": "24.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "postcss": "8.4.39",
    "react-doctor": "0.9.14",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.2",
    "vite": "5.3.2",
    "vitest": "1.3.1"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^20.19.0 || >=22.13.0"
  }
}
